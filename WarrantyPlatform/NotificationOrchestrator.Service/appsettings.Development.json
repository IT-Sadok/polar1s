{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Kafka": {
    "BootstrapServers": "localhost:29092",
    "SchemaRegistryUrl": "http://localhost:8081/apis/ccompat/v7",
    "Consumers": {
      "WarrantyEvents": {
        "Topic": "warranty-events",
        "GroupId": "notification-orchestrator",
        "AutoOffsetReset": "Latest"
      }
    },
    "Producers": {
      "NotificationCommands": {
        "Topic": "notification-commands",
        "Acks": "All"
      }
    }
  }
}
